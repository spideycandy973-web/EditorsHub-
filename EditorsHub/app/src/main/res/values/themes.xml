<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      MainActivity extends AppCompatActivity. AppCompat requires a Theme.AppCompat
      descendant; using a plain android:Theme.* here made setContent() throw
      "You need to use a Theme.AppCompat theme" on every device at launch.
    -->
    <style name="Theme.EditorsHub" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">#FF121214</item>
        <item name="android:statusBarColor">#FF121214</item>
        <item name="android:navigationBarColor">#FF121214</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:colorAccent">#FF01FFA7</item>
        <item name="colorAccent">#FF01FFA7</item>
    </style>

    <style name="Theme.EditorsHub.Splash" parent="Theme.EditorsHub">
        <item name="android:windowSplashScreenBackground">#FF121214</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
